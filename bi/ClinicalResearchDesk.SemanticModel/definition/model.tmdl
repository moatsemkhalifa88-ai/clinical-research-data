model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: he-IL
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["TMDLView_Desktop","DevMode"]

annotation PBI_QueryOrder = ["fact_patient","dim_lactate_band","dim_age_band","dim_care_unit","cohort_flow","validation_checks","DataFolder"]

ref table fact_patient
ref table dim_lactate_band
ref table dim_age_band
ref table dim_care_unit
ref table cohort_flow
ref table validation_checks

ref cultureInfo en-US

