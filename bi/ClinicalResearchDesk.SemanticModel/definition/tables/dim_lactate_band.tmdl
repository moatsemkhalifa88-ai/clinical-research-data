	partition dim_lactate_band = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\dim_lactate_band.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers, {{"lactate_band", type text}, {"sort_order", Int64.Type}, {"meaning", type text}, {"range_mmol_l", type text}}, "en-US")
				in
					Typed

